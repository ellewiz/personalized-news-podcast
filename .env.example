# Copy this file to .env and fill in real values. Never commit .env.

# Public URL the RSS feed and MP3s will be served from once GitHub Pages
# is enabled (Settings > Pages > Deploy from branch > main /docs).
PODCAST_BASE_URL=https://<your-github-username>.github.io/personalized-news-podcast

# Anthropic API key, used for script generation (podcast/script.py).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs API key, used for text-to-speech (podcast/tts.py).
ELEVENLABS_API_KEY=

# How far back to pull items when fetching feeds (hours).
RECENCY_WINDOW_HOURS=36
