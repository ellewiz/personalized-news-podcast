# Copy this file to .env and fill in real values. Never commit .env.

# Public URL the RSS feed and MP3s will be served from once GitHub Pages
# is enabled (Settings > Pages > Deploy from branch > main /docs).
PODCAST_BASE_URL=https://<your-github-username>.github.io/personalized-news-podcast

# Anthropic API key, used for script generation (podcast/script.py).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Cloud Text-to-Speech API key, used for TTS (podcast/tts.py).
# Create one in Google Cloud Console: enable the "Cloud Text-to-Speech API"
# on a project, then Credentials > Create Credentials > API key. The free
# tier covers 1M characters/month of Neural2 voices.
GOOGLE_TTS_API_KEY=

# How far back to pull items when fetching feeds (hours).
RECENCY_WINDOW_HOURS=36

# Weather segment location (National Weather Service API, no key needed).
# Defaults below are Skillman, NJ 08558 — override if needed.
# WEATHER_LAT=40.408516
# WEATHER_LON=-74.694682
# WEATHER_LOCATION_LABEL=Skillman, New Jersey

# Optional: phone push when a run fails, via https://ntfy.sh (free, no account).
# Pick a long unguessable topic name, then subscribe to it in the ntfy app.
NTFY_TOPIC=

# Optional: only publish on office mornings. Uses a Home Assistant calendar
# whose events have "office" or "WFH" in the description (default:
# calendar.master_calendar). Set HA_URL to turn it on; HA_TOKEN is a long-lived
# access token (HA profile page > Security). On a WFH day, or a day with no
# such event, the run is skipped; if HA can't be reached it is skipped and you
# get the failure alert. Run manually past it with: FORCE_RUN=1 scripts/publish.sh
HA_URL=
HA_TOKEN=
# HA_CALENDAR=calendar.master_calendar
# HA_WORKDAY_CALENDAR=calendar.workday_calendar  # checked first; no event = not a workday
